{
  "entities": {
    "MeditationSession": {
      "title": "MeditationSession",
      "description": "A recorded meditation sitting with duration, technique, and mindful reflections",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique session ID" },
        "technique": { "type": "string", "description": "Technique slug", "maxLength": 80 },
        "title": { "type": "string", "description": "Session title", "maxLength": 160 },
        "durationSeconds": { "type": "number", "description": "Duration in seconds" },
        "completed": { "type": "boolean", "description": "Whether sitting was completed" },
        "moodBefore": { "type": "number", "description": "Heart rating before sit (1-5)" },
        "moodAfter": { "type": "number", "description": "Heart rating after sit (1-5)" },
        "notes": { "type": "string", "description": "Post-sit insights or notes", "maxLength": 2000 },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "userId": { "type": "string", "description": "User ID or anonymous sanctuary ID" }
      },
      "required": ["technique", "title", "durationSeconds", "completed", "createdAt"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Mindful reflection entry written after meditation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique reflection ID" },
        "title": { "type": "string", "description": "Reflection title", "maxLength": 200 },
        "content": { "type": "string", "description": "Reflection text", "maxLength": 10000 },
        "mood": { "type": "string", "description": "Weather of heart", "maxLength": 50 },
        "prompt": { "type": "string", "description": "Contemplation prompt", "maxLength": 500 },
        "gratitude": { "type": "string", "description": "Gratitude note", "maxLength": 2000 },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" },
        "userId": { "type": "string", "description": "User ID or sanctuary ID" }
      },
      "required": ["title", "content", "createdAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "Daily meditation goal and consistency habit tracker",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique habit ID" },
        "title": { "type": "string", "description": "Habit title e.g. Sit for 10 minutes", "maxLength": 120 },
        "targetMinutes": { "type": "number", "description": "Target sitting minutes per day" },
        "frequency": { "type": "string", "description": "daily, morning, or evening", "maxLength": 30 },
        "streak": { "type": "number", "description": "Current consecutive streak days" },
        "completedDates": { "type": "string", "description": "JSON array of completed date strings" },
        "active": { "type": "boolean", "description": "Active status of habit" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" },
        "userId": { "type": "string", "description": "User ID or sanctuary ID" }
      },
      "required": ["title", "targetMinutes", "active", "createdAt"]
    },
    "PracticePlan": {
      "title": "PracticePlan",
      "description": "7-day customized meditation program generated by the Bodhi Guide",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique plan ID" },
        "title": { "type": "string", "description": "Plan title", "maxLength": 120 },
        "goal": { "type": "string", "description": "User goal or focus", "maxLength": 200 },
        "minutesPerDay": { "type": "number", "description": "Minutes per day" },
        "level": { "type": "string", "description": "Skill level", "maxLength": 50 },
        "days": { "type": "string", "description": "JSON representation of plan days" },
        "active": { "type": "boolean", "description": "Whether this is current pinned plan" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "userId": { "type": "string", "description": "User ID or sanctuary ID" }
      },
      "required": ["title", "days", "active", "createdAt"]
    }
  },
  "firestore": {
    "/meditation_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/MeditationSession" },
      "description": "Collection of recorded meditation sittings"
    },
    "/journal_entries/{entryId}": {
      "schema": { "$ref": "#/entities/JournalEntry" },
      "description": "Collection of contemplative journal reflections"
    },
    "/habits/{habitId}": {
      "schema": { "$ref": "#/entities/Habit" },
      "description": "Collection of daily meditation goals and habits"
    },
    "/practice_plans/{planId}": {
      "schema": { "$ref": "#/entities/PracticePlan" },
      "description": "Collection of 7-day practice plans"
    },
    "/test/{testId}": {
      "schema": "string",
      "description": "Health and connection check documents"
    }
  }
}
